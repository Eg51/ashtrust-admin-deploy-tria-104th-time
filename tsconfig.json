{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "node",
      "mongodb"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
   "lib/firebase.ts",
   "./node_modules/@types",
   "lib/db.js",
   "lib/session.js",
   "lib/security.js",
   "lib/mongodb.js",
   "app/api/user/dashboard/route.js",
   "app/api/user/bills/route.js",
   "app/api/auth/login/route.js",
   "app/api/auth/register/route.js",
   "app/api/admin/users/route.js",
   "types/index.ts",
   "app/actions/getAdminUser.js",
   "app/actions/admin.js",
   "app/api/user/avatar/route.js",
   "app/components/DesktopNav.tsx",
   "app/components/DesktopNav.tsx"
  ],
  "exclude": [
  ]
}