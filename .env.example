NODE_ENV=example
APP_URL=http://(NETWORK PORT NAME OR DOMAIN NAME)
API_URL=http://(NETWORK PORT NAME OR DOMAIN NAME)/api
MONGODB_URI="(Database uri)"
MONGODB_DB="(Data base name)"
MONGODB_OPTIONS="retryWrites=true&w=majority&appName=NextApp"
MONGODB_COLLECTION_(data base collection name)="(data base collection name)"
MONGODB_COLLECTION_(data base collection name)="(data base collection name)"
MONGODB_COLLECTION_(data base collection name)="(data base collection name)"
CORS_ORIGIN=http://(NETWORK PORT NAME OR DOMAIN NAME)
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_CREDENTIALS=true
NEXTAUTH_URL=http://(NETWORK PORT NAME OR DOMAIN NAME)
NEXTAUTH_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NEXT_PUBLIC_API_URL=http://(NETWORK PORT NAME OR DOMAIN NAME)/api
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
SESSION_TIMEOUT=1800
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_MAX_AGE=3600
# Auto-Balance Settings
AUTO_BALANCE_AMOUNT=0.01
AUTO_BALANCE_INTERVAL=7200000
CRON_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX